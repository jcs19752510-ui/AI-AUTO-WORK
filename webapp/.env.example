# 로컬 개발용 예시 파일. 실제 .env는 절대 커밋하지 않는다(.gitignore 처리됨).
# Render/GitHub Actions 등 실제 배포 환경은 이 파일을 쓰지 않고 플랫폼
# Environment Variables/Secrets에 직접 값을 등록한다 (03 §5.4).

DJANGO_SETTINGS_MODULE=config.settings.dev

# dev.py는 이 값이 없으면 개발 전용 기본 SECRET_KEY로 대체된다. production.py는
# 이 값이 없으면 기동 자체가 실패한다(의도된 동작, 03 §5.4).
SECRET_KEY=

# 비워두면 SQLite로 폴백(dev.py). 로컬 Postgres나 Neon으로 테스트하려면
# postgres://user:password@host:5432/dbname 형태로 지정.
# Neon 사용 시: 실제 프로젝트가 아직 발급되지 않음(10~12단계에서 생성 예정).
# 발급되면 Neon 대시보드의 "pooled connection string"(host에 -pooler가 붙은
# 형태) 제공 여부를 반드시 재확인하고, 제공되면 그 값을 사용할 것(03 §6.4).
DATABASE_URL=

# production.py 전용 (dev에서는 사용하지 않음)
DJANGO_ALLOWED_HOSTS=
WAGTAILADMIN_BASE_URL=

# Cloudflare R2 (S3 호환, media-public 버킷) — 03 §2.3, DEC-008.
# 실제 버킷/키는 아직 발급되지 않음(10~12단계에서 생성 예정).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_REGION=auto
R2_PUBLIC_BASE_URL=

# Cloudflare R2 백업 버킷(backup-private, 03 §2.3/§7.5, DEC-008/DEC-010) —
# 비워두면 "backup" 스토리지 별칭 자체가 비활성 상태로 유지된다(WU-03은 설정
# 골격만 제공, 실제 사용은 WU-10). 값을 채우면 media-public과 물리적으로
# 분리된 버킷이 활성화된다. R2_BACKUP_ACCESS_KEY_ID/SECRET을 비워두면 위
# media-public 자격증명을 임시로 재사용한다 — WU-10 착수 시 버킷 범위가
# 분리된 전용 토큰 발급을 권고(최소 권한 원칙).
R2_BACKUP_BUCKET_NAME=
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=

# 장애 알림(REQ-012, 03 §7.2) — 500 에러 발생 시 이 주소로 즉시 메일 발송.
# 쉼표로 여러 주소 구분 가능. 비워두면 알림이 조용히 발송되지 않을 뿐 기동은
# 막지 않는다(production.py).
DJANGO_ADMIN_EMAIL=

# 최초 슈퍼유저 부트스트랩 전용(WU-09, build.sh의 ensure_superuser). 최초
# 배포 성공 후에는 세 값 모두 지워도 된다(권장, ADMIN_ACCESS_GUIDE.md 참고) —
# 지운다고 이미 생성된 계정에는 영향이 없다(멱등 커맨드).
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# 장애 알림 메일 발송에 쓰는 SMTP 설정(DJANGO_ADMIN_EMAIL과 짝을 이룬다).
# 운영자가 선택한 SMTP 공급자(예: SendGrid, Mailgun, Gmail SMTP 등)에 맞춰
# 채운다. 비워두면 알림 메일이 발송 시도 시 오류를 남길 뿐 기동은 막지 않는다.
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
EMAIL_USE_TLS=true

# 알림 메일의 발신 주소(비워두면 errors@<RENDER_EXTERNAL_HOSTNAME> 또는
# errors@localhost로 자동 대체됨, production.py 참고).
SERVER_EMAIL=
